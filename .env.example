# PostgreSQL connection string
DATABASE_URL=postgresql://payload:payload@localhost:5432/jamjam

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://jamjam.dev

# Fallback for local development
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Dev only: comma-separated hostnames allowed to load Next.js dev bundles (Tailscale MagicDNS, LAN IP, etc.)
# NEXT_DEV_EXTRA_ORIGINS=chaos-wsl.tailf3d3c5.ts.net

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Anthropic API key (server-side only, for AI features)
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Roast my website (Gemini via OpenAI-compatible endpoint)
# https://ai.google.dev/gemini-api/docs/openai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Mux Video (optional)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SIGNING_SECRET=

# Cloudflare R2 (optional). Set R2_* in Vercel (and locally if needed) so
# next.config CSP and Payload see the same values.
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_URL=https://media.jamjam.dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional alias for tooling that only reads NEXT_PUBLIC_* at build time:
# NEXT_PUBLIC_MEDIA_URL=https://media.jamjam.dev


